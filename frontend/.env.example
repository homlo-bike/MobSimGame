# Frontend build-time configuration. Everything here is PUBLIC and ends up in the
# browser bundle. Never put API keys, tokens or passwords in VITE_* variables.

# Base URL of the MobSimGame backend API (empty = same origin, served under /api)
VITE_API_BASE_URL=
# Comma-separated list of extra MapLibre style URLs: "Label|https://example.org/style.json"
VITE_EXTRA_BASEMAPS=
# Terrain DEM tile template (Terrarium encoding). Empty disables the terrain toggle.
VITE_TERRAIN_TILES_URL=https://elevation-tiles-prod.s3.amazonaws.com/terrarium/{z}/{x}/{y}.png
# Link shown in "Data & licences" for obtaining this deployment's source (AGPL obligation of a bundled library)
VITE_SOURCE_URL=https://github.com/homlo-bike/MobSimGame
