# Test (CI, end-to-end runs): docker compose --env-file env/test.env up -d
# Local, non-secret values only (this file is committed). Never reuse them on a server.
# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Database (required)
POSTGRES_DB=mobsim
POSTGRES_USER=mobsim
POSTGRES_PASSWORD=test-only-password

# Login for saving and sharing projects on the server (the editor itself needs no login;
# shared links stay viewable without one). The default is admin / admin. The API refuses
# to start with the default password when MOBSIM_ENVIRONMENT=production (the Compose
# default), so set your own password, or MOBSIM_ENVIRONMENT=development on a test machine.
MOBSIM_ENVIRONMENT=test
MOBSIM_ADMIN_USERNAME=admin
MOBSIM_ADMIN_PASSWORD=test-only-admin-password
# Signs login sessions; set a long random value so sessions survive API restarts.
MOBSIM_SESSION_SECRET=test-only-session-secret

# Logging. Levels: debug | info (alias log) | warning (alias warn) | error.
# Debug is never enabled when MOBSIM_ENVIRONMENT=production (falls back to info).
# LOG_LEVEL is accepted as a fallback name for MOBSIM_LOG_LEVEL.
MOBSIM_LOG_LEVEL=info
# json (one object per line), text (readable) or auto (json in production, text otherwise)
MOBSIM_LOG_FORMAT=text
# Browser console level baked into the web build (public value)
VITE_LOG_LEVEL=info

# Public URL and CORS
MOBSIM_PUBLIC_BASE_URL=http://localhost:8080
MOBSIM_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
MOBSIM_WEB_PORT=8080
# Shown to Nominatim as a contact (recommended by its usage policy)
MOBSIM_CONTACT_EMAIL=

# OpenStreetMap / Overpass (public instance by default; self-host for heavier use)
MOBSIM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Set to false only behind a trusted egress proxy that resolves DNS for you
MOBSIM_OUTBOUND_DNS_CHECK=true

# Street routing for bus/BRT (optional): run `docker compose --profile routing up -d`
# and point the API at the internal Valhalla service. Space-separated OSM extract URLs
# (e.g. from https://download.geofabrik.de) decide which regions can be routed.
MOBSIM_VALHALLA_URL=http://valhalla:8002
VALHALLA_TILE_URLS=https://download.geofabrik.de/europe/germany/berlin-latest.osm.pbf
# Pin a release tag here for reproducible deployments.
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:latest

# Optional providers — leave empty to keep them disabled
MOBSIM_ARCGIS_TOKEN=
MOBSIM_CAMARA_POPULATION_URL=
MOBSIM_CAMARA_TOKEN_URL=
MOBSIM_CAMARA_CLIENT_ID=
MOBSIM_CAMARA_CLIENT_SECRET=
MOBSIM_TRANSPORT_REST_ENABLED=false
